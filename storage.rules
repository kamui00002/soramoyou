rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // NOTE: Firebase Storage rules cannot access Firestore data.
    // Follower access control is handled at the Firestore level.
    // For followers-only content, the app should:
    // 1. Check follower status via Firestore rules when fetching posts
    // 2. Use signed URLs or Cloud Functions for image delivery in Phase 2

    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidSize() {
      // Max 5MB
      return request.resource.size < 5 * 1024 * 1024;
    }

    // User profile images
    match /users/{userId}/profile/{imageId} {
      // Only authenticated users can read profile images
      allow read: if isAuthenticated();

      // Only the owner can upload their profile images
      allow create, update: if isOwner(userId) && isImageFile() && isValidSize();

      // Only the owner can delete (no file validation: request.resource is null on delete)
      allow delete: if isOwner(userId);
    }

    // Post images - public
    match /posts/{userId}/public/{imageId} {
      // Anyone can read public images
      allow read: if true;

      // Only authenticated owner can upload public images
      // NOTE: テスト中は条件を緩和（本番前に戻すこと）
      allow create, update: if isOwner(userId)
                   && isImageFile()
                   && isValidSize();

      // Only the owner can delete (no file validation: request.resource is null on delete)
      allow delete: if isOwner(userId);
    }

    // Post images - followers only
    // NOTE: Storage cannot verify Firestore followers collection.
    // Currently allows authenticated users; actual follower check is done
    // at Firestore level when fetching post metadata.
    // Phase 2: Implement signed URLs via Cloud Functions for proper access control.
    // NOTE: Phase 2でCloud Functionsを使った署名URL方式で完全なアクセス制御を実装予定
    // 現状はログイン済みユーザー全員が読み取り可能（一時的な制限）
    match /posts/{userId}/followers/{imageId} {
      // Authenticated users can read (follower check at Firestore level)
      allow read: if isAuthenticated();

      // Only the owner can upload followers-only images
      allow create, update: if isOwner(userId) && isImageFile() && isValidSize();

      // Only the owner can delete (no file validation: request.resource is null on delete)
      allow delete: if isOwner(userId);
    }

    // Post images - private
    match /posts/{userId}/private/{imageId} {
      // Only the owner can read private images
      allow read: if isOwner(userId);

      // Only the owner can upload private images
      allow create, update: if isOwner(userId) && isImageFile() && isValidSize();

      // Only the owner can delete (no file validation: request.resource is null on delete)
      allow delete: if isOwner(userId);
    }

    // Draft images
    match /drafts/{userId}/{imageId} {
      // Only the owner can read draft images
      allow read: if isOwner(userId);

      // Only the owner can write draft images (with file type and size validation)
      allow create, update: if isOwner(userId) && isImageFile() && isValidSize();

      // Only the owner can delete draft images (no file validation needed for delete)
      allow delete: if isOwner(userId);
    }

    // Thumbnail images - public
    match /thumbnails/{userId}/public/{imageId} {
      // Anyone can read public thumbnails
      allow read: if true;

      // Only authenticated owner can upload public thumbnails
      // NOTE: テスト中は条件を緩和（本番前に戻すこと）
      allow create, update: if isOwner(userId)
                   && isImageFile()
                   && isValidSize();

      // Only the owner can delete (no file validation: request.resource is null on delete)
      allow delete: if isOwner(userId);
    }

    // Thumbnail images - followers only
    // NOTE: Same limitation as posts - follower check at Firestore level
    // NOTE: Phase 2でCloud Functionsを使った署名URL方式で完全なアクセス制御を実装予定
    // 現状はログイン済みユーザー全員が読み取り可能（一時的な制限）
    match /thumbnails/{userId}/followers/{imageId} {
      // Authenticated users can read (follower check at Firestore level)
      allow read: if isAuthenticated();

      // Only the owner can upload followers-only thumbnails
      allow create, update: if isOwner(userId) && isImageFile() && isValidSize();

      // Only the owner can delete (no file validation: request.resource is null on delete)
      allow delete: if isOwner(userId);
    }

    // Thumbnail images - private
    match /thumbnails/{userId}/private/{imageId} {
      // Only the owner can read private thumbnails
      allow read: if isOwner(userId);

      // Only the owner can upload private thumbnails
      allow create, update: if isOwner(userId) && isImageFile() && isValidSize();

      // Only the owner can delete (no file validation: request.resource is null on delete)
      allow delete: if isOwner(userId);
    }

    // Original images (unedited) - public
    match /originals/{userId}/public/{imageId} {
      // Anyone can read public original images
      allow read: if true;

      // Only authenticated owner can upload public original images
      // NOTE: テスト中は条件を緩和（本番前に戻すこと）
      allow create, update: if isOwner(userId)
                   && isImageFile()
                   && isValidSize();

      // Only the owner can delete (no file validation: request.resource is null on delete)
      allow delete: if isOwner(userId);
    }

    // Original images (unedited) - followers only
    // NOTE: Same limitation as posts - follower check at Firestore level
    // NOTE: Phase 2でCloud Functionsを使った署名URL方式で完全なアクセス制御を実装予定
    // 現状はログイン済みユーザー全員が読み取り可能（一時的な制限）
    match /originals/{userId}/followers/{imageId} {
      // Authenticated users can read (follower check at Firestore level)
      allow read: if isAuthenticated();

      // Only the owner can upload followers-only original images
      allow create, update: if isOwner(userId) && isImageFile() && isValidSize();

      // Only the owner can delete (no file validation: request.resource is null on delete)
      allow delete: if isOwner(userId);
    }

    // Original images (unedited) - private
    match /originals/{userId}/private/{imageId} {
      // Only the owner can read private original images
      allow read: if isOwner(userId);

      // Only the owner can upload private original images
      allow create, update: if isOwner(userId) && isImageFile() && isValidSize();

      // Only the owner can delete (no file validation: request.resource is null on delete)
      allow delete: if isOwner(userId);
    }

    // Living Sky job assets (source photo + masks uploaded by client,
    // output.mp4 written server-side by Cloud Functions via Admin SDK).
    // DEBUG-only E2E feature; client only ever writes the 3 input images.
    // Access is further gated by the custom claim `skyMotionBeta` (allowlist),
    // since rules/Functions themselves are deployed to production and reachable
    // by any authenticated (incl. anonymous, self-signup) user otherwise.
    match /livingSky/{userId}/{jobId}/{fileName} {
      // Only the owner can read (input images + the finished output.mp4)
      allow read: if isOwner(userId);

      // Only an allowlisted owner can upload the 3 known input image files
      // (source.jpg / sky_mask.png / ground_mask.png). Restricting fileName to
      // this whitelist makes output.mp4 write genuinely unreachable through this
      // client path (previously only true "by convention" via isImageFile(),
      // since Cloud Functions always writes output.mp4 server-side via the
      // Admin SDK, which bypasses these rules entirely).
      allow write: if isOwner(userId)
                   && request.auth.token.skyMotionBeta == true
                   && fileName in ['source.jpg', 'sky_mask.png', 'ground_mask.png']
                   && isImageFile()
                   && isValidSize();
    }

    // ============================================
    // そらとも（招待制の小さなグループで空を共有する）の画像 ⭐️
    // spec: .kiro/specs/soratomo/（tasks 4.1）
    // パス: soratomo/{groupId}/{authorId}/{skyId}/display.jpg と thumb.jpg（アプリだけが作成・削除する）
    // - 読み取りは、機能フラグを持つそのグループのメンバーだけ。Firestore のメンバーの文書の存在で判定する（1 回の評価で 1 件）
    // - Storage のルールから Firestore を読むには、初回の deploy で IAM の付与が要る（tasks 4.3）。
    //   付与しないと、メンバーの読み取りも拒否される
    // - 作成と削除を同じ allow write にまとめない。削除の要求には request.resource が無いので、
    //   内容の検査を混ぜると削除が必ず拒否される（PR #141 と同じ型の不具合）
    // - 既存のパスのルールは変えない（要件 13.8）
    // テスト: Rules test API で firestore.exists をモックして評価する（research.md の要確認 2・tasks 4.2）
    // ============================================
    match /soratomo/{groupId}/{authorId}/{skyId}/{fileName} {
      // 機能フラグ（カスタムクレーム soratomoBeta）を持つログイン利用者か（要件 1.6）
      // - firestore.rules の isSoratomoUser() と同じ条件。token.soratomoBeta と直接書くと、
      //   クレームの無い人では「項目が無い」エラーで拒否になる。get の既定値 false で読み、条件として拒否する
      function isSoratomoUser() {
        return isAuthenticated() && request.auth.token.get('soratomoBeta', false) == true;
      }

      // そのグループのメンバーか（要件 11.1・11.2）
      // - request.auth.uid を読むので、必ず isSoratomoUser() の後ろに && でつなぐ（未ログインで評価させない）
      function isSoratomoMember() {
        return firestore.exists(/databases/(default)/documents/soratomoGroups/$(groupId)/members/$(request.auth.uid));
      }

      // 保存できる大きさの上限（バイト）。表示用は 1.5MB、サムネイルは 200KB（要件 11.5）
      function maxSoratomoImageSize(name) {
        return name == 'display.jpg' ? 1572864 : 204800;
      }

      allow read: if isSoratomoUser() && isSoratomoMember();

      // 作成: メンバー本人が自分の投稿者のパスへ、決まった 2 つのファイル名の JPEG を上限以内で保存するときだけ（要件 11.5）
      // - 投稿者 ID の一致を先に見て、他人のパスでは Firestore を読まずに拒否する
      allow create: if isSoratomoUser()
                    && request.auth.uid == authorId
                    && isSoratomoMember()
                    && fileName in ['display.jpg', 'thumb.jpg']
                    && request.resource.contentType == 'image/jpeg'
                    && request.resource.size <= maxSoratomoImageSize(fileName);

      // 上書きは拒否する（投稿の再試行は新しい投稿 ID で保存する）
      allow update: if false;

      // 削除: 投稿者本人だけ（オーナーを含むほかのメンバーには許さない。要件 11.6・11.15）
      // - 内容（request.resource）の検査を含めない（要件 11.7）
      allow delete: if isSoratomoUser() && request.auth.uid == authorId;
    }
  }
}
