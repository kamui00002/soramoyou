<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐️ 検証用の変種（emulator）だけに重ねる設定（タスク 11.1・要件 1.3）。
     - 開発機のエミュレータは http なので、仮想端末から開発機（10.0.2.2）への平文の通信だけを許す
     - Firebase Analytics と Crashlytics の収集を切る（検証用のプロジェクトへ送っても意味が無く、本番の計測にも混ぜない）
     EmulatorBuildIsolationTest が meta-data の値を確かめる -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/emulator_network_security_config">
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
    </application>
</manifest>
